{
  "name": "dsh-quota-dashboard",
  "version": "1.0.5",
  "description": "通用多平台 API 额度/余额实时监视器（DeepSeek Harness Web GUI 插件）：侧边栏实时显示 DeepSeek / Moonshot / OpenRouter / OpenCode Go 等平台余额与订阅额度，DeepSeek 峰谷时段倒计时，跟随 DSH 明暗主题，可调刷新间隔（30s–5min），配置跨重启/浏览器持久化。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "quota",
    "usage",
    "balance",
    "deepseek",
    "moonshot",
    "openrouter",
    "opencode",
    "web-gui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6"
  }
}