{
  "name": "dsh-quota-dashboard",
  "version": "1.0.7",
  "description": "通用多平台 API 额度/余额实时监视器（DeepSeek Harness Web GUI 插件）：侧边栏实时显示 DeepSeek 官方接口 / OpenCode Go 订阅等平台余额与订阅额度（其余平台走自定义接口），DeepSeek 峰谷时段倒计时（官方峰谷定价：工作日高峰 2 倍、空闲半价），跟随 DSH 明暗主题，可调刷新间隔（30s–5min），配置跨重启/浏览器持久化。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "quota",
    "usage",
    "balance",
    "deepseek",
    "opencode",
    "web-gui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/test-contract.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6"
  }
}